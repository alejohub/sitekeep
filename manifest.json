{
  "manifest_version":3,
  "name":"SiteKeep",
  "version":"0.1.0",
  "description":"Protege sitios y limpia sus datos localmente.",
  "minimum_chrome_version":"130",
  "permissions":["browsingData","cookies","storage","alarms","tabs"],
  "optional_permissions":["history"],
  "host_permissions":["http://*/*","https://*/*"],
  "background":{"service_worker":"src/background/worker.js","type":"module"},
  "action":{"default_popup":"src/popup/index.html","default_title":"SiteKeep","default_icon":{"16":"icons/16.png","32":"icons/32.png"}},
  "icons":{"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"},
  "options_ui":{"page":"src/options/index.html","open_in_tab":true},
  "content_security_policy":{"extension_pages":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'; form-action 'none'"}
}
